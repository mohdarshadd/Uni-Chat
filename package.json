{
  "name": "campus-chat",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @campus-chat/server --filter @campus-chat/web dev",
    "build": "pnpm --filter @campus-chat/shared build && pnpm --filter @campus-chat/server build && pnpm --filter @campus-chat/web build",
    "lint": "pnpm --parallel --filter @campus-chat/server --filter @campus-chat/web lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\"",
    "clean": "rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.4.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
