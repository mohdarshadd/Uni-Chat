# ── Server ──
PORT=3001
NODE_ENV=development

# MongoDB connection string (use MongoDB Atlas in production)
MONGODB_URI=mongodb://localhost:27017/campus-chat

# Redis (not currently used — can be omitted)
REDIS_URL=redis://localhost:6379

# JWT — must be at least 32 characters
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars

# Admin panel access key
ADMIN_KEY=admin-secret-change-me

# ── Frontend (only used in dev for Vite proxy bypass) ──
# Leave empty to use Vite proxy (/api → localhost:3001)
VITE_API_URL=
VITE_SOCKET_URL=

# GIPHY API key — https://developers.giphy.com/
VITE_GIPHY_API_KEY=your_giphy_api_key_here
